    "Choose a .glsl fragment shader whose first line names it, such as // {\"name\": \"Sepia\"}.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un shader .glsl dont la première ligne le nomme, par exemple // {\"name\": \"Sépia\"}."
          }
        }
      }
    },
    "Choose a folder to look for Ren'Py games in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier où chercher des jeux Ren’Py."
          }
        }
      }
    },
    "Choose a game folder, a Mac .app, or a zip.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier de jeu, une app Mac ou un zip."
          }
        }
      }
    },
    "Choose a mod: a zip, a folder, or .rpy, .rpyc or .rpa files. RenChan keeps its own copy.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un mod : un zip, un dossier, ou des fichiers .rpy, .rpyc ou .rpa. RenChan garde sa propre copie."
          }
        }
      }
    },
    "Choose a picture for the game's cover.": {
