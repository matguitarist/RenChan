      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RenChan"
          }
        }
      }
    },
    "RenChan couldn't save the library: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RenChan n’a pas pu enregistrer la bibliothèque : %@"
