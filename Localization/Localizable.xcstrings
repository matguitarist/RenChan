    "Looks once a day for a new version on GitHub.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie une fois par jour si une nouvelle version existe sur GitHub."
          }
        }
      }
    },
    "Looks once a day for a new version on GitHub. Last checked %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie une fois par jour si une nouvelle version existe sur GitHub. Dernière vérification : %@."
