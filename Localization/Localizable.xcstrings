    "RenChan": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RenChan"
          }
        }
      }
    },
    "RenChan on GitHub": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RenChan sur GitHub"
          }
        }
      }
    },
    "RenChan will keep your Ren'Py visual novels in one place and play any of them on this Mac, even games made only for Windows or Linux, with screen filters and mods that never change the game.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RenChan rassemblera vos romans visuels Ren’Py au même endroit et lancera n’importe lequel sur ce Mac, même les jeux conçus uniquement pour Windows ou Linux, avec des filtres d’écran et des mods qui ne modifient jamais le jeu."
          }
        }
      }
    },
    "Restart Now": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrer maintenant"
          }
        }
      }
    },
    "System (%@)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système (%@)"
          }
        }
      }
    },
    "The new language applies after a restart.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue s’appliquera après un redémarrage."
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour"
          }
        }
      }
    },
    "Updates are off in this build.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour sont désactivées dans cette version."
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        }
      }
    },
    "What RenChan does shows here: games added, runtimes downloaded, games played.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que fait RenChan s’affiche ici : jeux ajoutés, versions de Ren’Py téléchargées, parties lancées."
          }
        }
      }
    },
    "Your Ren'Py Library": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque Ren’Py"
          }
        }
      }
