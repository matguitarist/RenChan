{
  "sourceLanguage": "en",
  "strings": {
    "%@ (missing)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (manquant)"
          }
        }
      }
    },
    "%@ all change the screen “%@”; Ren'Py uses the one it loads last.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ modifient tous l’écran « %2$@ » ; Ren’Py utilise celui qu’il charge en dernier."
          }
        }
      }
    },
    "%@ already plays this version.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise déjà cette version."
          }
        }
      }
    },
    "%@ and %@ both have %@; %@'s is used.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ et %2$@ ont tous deux %3$@ ; celui de %4$@ est utilisé."
          }
        }
      }
    },
    "%@ has no Ren'Py files (.rpy, .rpyc or .rpa), so it can't change the game.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne contient aucun fichier Ren’Py (.rpy, .rpyc ou .rpa) : il ne peut pas modifier le jeu."
          }
        }
      }
    },
    "%@ isn't a mod RenChan can add. Choose a zip, a folder, or .rpy, .rpyc or .rpa files.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas un mod que RenChan peut ajouter. Choisissez un zip, un dossier, ou des fichiers .rpy, .rpyc ou .rpa."
          }
        }
      }
    },
    "%@ isn't a walkthrough RenChan can show. Choose a PDF or a text file.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas une soluce que RenChan peut afficher. Choisissez un PDF ou un fichier texte."
          }
        }
      }
    },
    "%@ isn't really a PDF. If it came from itch.io, its download link may have expired: download it again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas vraiment un PDF. S’il vient d’itch.io, son lien de téléchargement a peut-être expiré : téléchargez-le de nouveau."
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@"
          }
        }
      }
    },
    "%@ quit with an error": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’est arrêté sur une erreur"
          }
        }
      }
    },
    "%@ was refused: it would write outside its folder (%@).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a été refusé : il écrirait hors de son dossier (%2$@)."
          }
        }
      }
    },
